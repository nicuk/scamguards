# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Vercel Supabase Integration (auto-created by Vercel)
# STORAGE_SUPABASE_URL=auto
# NEXT_PUBLIC_STORAGE_SUPABASE_URL=auto
# STORAGE_SUPABASE_PUBLISHABLE_KEY=auto

# Qwen / DashScope API (Alibaba Cloud)
# Get your key at: https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=your_dashscope_api_key

# Admin Email Whitelist (comma-separated)
# Only these emails can access /admin/dashboard after logging in
# Example: "admin@example.com,boss@company.com"
ADMIN_EMAILS=your_email@example.com

# Stripe Payment Link (for donations)
# Create at: Stripe Dashboard → Payment Links → New → "Customer chooses price"
NEXT_PUBLIC_STRIPE_DONATE_LINK=https://buy.stripe.com/your_link_here

# Google Analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Bing Webmaster Tools
BING_SITE_VERIFICATION=your_bing_verification_code

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3000
